# GitHub API configuration for fetching writing history
# Required:
GITHUB_OWNER=your-username
GITHUB_REPO=idealists-site

# Optional but recommended (avoids rate limits):
# Create at: https://github.com/settings/tokens
# Reading history needs no scopes on a public repo. Saving annotations commits
# to main through this token, so that needs `contents: write` on the repo —
# only grant it where annotation saving should actually work.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub OAuth for annotations (optional)
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# Interviewer backend (FastAPI, exposed via ngrok or a reserved domain).
# Used by /interview. Falls back to http://127.0.0.1:8000 when unset.
PUBLIC_INTERVIEWER_API=https://your-interviewer-host.example.com

# Upstash Redis (Vercel Marketplace → Storage). Used by /vibes/duel for vibe ratings.
# `vercel env pull .env.local` fills these in; the duel page shows a resting message when unset.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-token
